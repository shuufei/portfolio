---
interface Props {
  title: string;
  description?: string;
  thumbnail?: string;
}
const { title, description, thumbnail } = Astro.props;
---

<div class="output-card">
  {thumbnail
    ? <img class="card-thumbnail" src={thumbnail} alt={title} />
    : <div class="card-thumbnail card-thumbnail--placeholder" aria-hidden="true" />
  }
  <div class="title-section">
    <p class="card-title">{title}</p>
    {description && <p class="card-desc">{description}</p>}
  </div>
</div>

<style>
  .output-card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: 12rem;
  }

  .title-section {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .card-thumbnail {
    width: 100%;
    aspect-ratio: 140 / 79;
    object-fit: cover;
    display: block;
  }

  .card-thumbnail--placeholder {
    background: #d9d9d9;
  }

  .card-title {
    font-family: 'Hiragino Sans', 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 300;
    font-size: 0.9rem;
    color: white;
    line-height: 1.4;
  }

  .card-desc {
    font-family: 'Hiragino Sans', 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 200;
    font-size: 0.75rem;
    color: white;
    line-height: 1.4;
  }
</style>
